{
  "name": "electrate",
  "version": "1.0.0",
  "description": "An Electron + React.js template with hot reload, built with electron-vite",
  "main": "out/main/index.js",
  "desktopName": "electrate.desktop",
  "scripts": {
    "build": "electron-vite build",
    "start": "electron-vite dev --watch",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "electron-vite build && electron-builder"
  },
  "homepage": "https://github.com/mmick66/electrate#readme",
  "bugs": {
    "url": "https://github.com/mmick66/electrate/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmick66/electrate.git"
  },
  "keywords": [
    "electron",
    "react",
    "template",
    "boilerplate",
    "live-reload"
  ],
  "author": "Michael Michailidis",
  "license": "CC0-1.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-react": "^8.0.1",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-jest": "^30.5.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^7.3.6"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "allowScripts": {
    "electron-winstaller": true,
    "esbuild": true,
    "unrs-resolver": true,
    "@parcel/watcher": false,
    "fsevents": false
  },
  "build": {
    "appId": "com.karmadust.electrate",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableCookieEncryption": true,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false,
      "resetAdHocDarwinSignature": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "notarize": true
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development",
      "syncDesktopName": true
    },
    "publish": null
  }
}
